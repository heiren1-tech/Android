<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13(API 33) 起发送通知需要该运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- 入口菜单 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========== 实验3：Android 界面组件 ========== -->
        <activity android:name=".Exp1ListActivity" android:exported="false" android:label="1. ListView 用法" />
        <activity android:name=".Exp2DialogActivity" android:exported="false" android:label="2. 自定义布局 AlertDialog" />
        <activity android:name=".Exp3MenuActivity" android:exported="false" android:label="MenuTest" />
        <activity android:name=".Exp4ActionModeActivity" android:exported="false" android:label="4. ActionMode 上下文菜单" />
        <activity android:name=".Exp5RecyclerActivity" android:exported="false" android:label="5. RecyclerView 列表" />

        <!-- ========== 4-AndroidUI：用户交互组件示例 ========== -->
        <activity android:name=".DemoButtonActivity" android:exported="false" android:label="Button 事件处理" />
        <activity android:name=".DemoCheckBoxActivity" android:exported="false" android:label="CheckButtonTest" />
        <activity android:name=".DemoNotificationActivity" android:exported="false" android:label="Notification 通知" />
        <activity android:name=".DemoDialogActivity" android:exported="false" android:label="AlertDialog 对话框" />
        <activity android:name=".DemoOptionMenuActivity" android:exported="false" android:label="OptionsMenu 选项菜单" />
        <activity android:name=".DemoContextMenuActivity" android:exported="false" android:label="ContextMenu 上下文菜单" />
        <activity android:name=".DemoPopupMenuActivity" android:exported="false" android:label="PopupMenu 弹出菜单" />
    </application>

</manifest>
